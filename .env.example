# Lien — ローカル実行用シークレットのテンプレート
#
# 使い方: cp .env.example .env して値を埋める(.env は .gitignore 済み・コミット禁止)
#   読み込み例: set -a; source .env; set +a
# エージェントは .env を読まない(DESIGN §7)。値の投入は人間が行う。

# Supabase CLI のアクセストークン(deploy.sh / lien-deploy.yml 用)
# 発行: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Supabase プロジェクトの DB パスワード(supabase db push 用)
# プロジェクト作成時に設定。忘れたら Project Settings > Database でリセット
SUPABASE_DB_PASSWORD=

# Supabase の anon(publishable)キー(scripts/g1/seed-pair.sh 用)
# Dashboard > Project Settings > API keys(sb_publishable_... / legacy anon どちらでも可)
SUPABASE_ANON_KEY=

# (任意)service_role キー — seed-pair.sh が promises 行を作るのに使用
# Dashboard > Project Settings > API keys(sb_secret_... / legacy service_role)
# SUPABASE_SERVICE_ROLE_KEY=
