<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group(DESIGN §3.1)。実体の ID は Config/Base.xcconfig の LIEN_APP_GROUP_ID。
	     codesign 時にビルド設定が展開される(CI は CODE_SIGNING_ALLOWED=NO のため未使用) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(LIEN_APP_GROUP_ID)</string>
	</array>
	<!-- APNs(issue #8 準備②)。Xcode 直インストールの development ビルドは sandbox。
	     TestFlight/App Store(T28)は production が必要 — アーカイブ署名時に自動で
	     差し替わる(automatic signing)。CI は CODE_SIGNING_ALLOWED=NO のため未使用。
	     アプリ本体のみ(Widget/NSE に APNs 登録は不要) -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
