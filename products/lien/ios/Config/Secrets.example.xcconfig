// Secrets.example.xcconfig — シークレット設定の雛形(DESIGN §7)
//
// 使い方(人間 / G0):
//   1. このファイルを同じディレクトリに Secrets.xcconfig としてコピーする
//   2. 下記プレースホルダを Supabase ダッシュボードの実値に置き換える
//   3. Secrets.xcconfig は .gitignore 済み。絶対にコミットしないこと
//
// 注: xcconfig では // がコメント開始のため、URL は $() でエスケープして記述する

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
// anon(publishable)キーだけを入れる。service_role / secret キーは絶対に入れない(アプリに同梱されて漏れる)
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// 実機・Xcode から署名して動かすときだけ(任意)。Apple Developer の Team ID(10 桁の英数字)。
// project.yml は xcodegen で毎回作り直されるため、Xcode の画面で選んだチームは消える。ここに書けば残る
// DEVELOPMENT_TEAM = ABCDE12345
