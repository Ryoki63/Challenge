// Base.xcconfig — 全ターゲット・全構成(Debug/Release)共通のビルド設定
// project.yml の configFiles から読み込まれる(DESIGN §3.1〜§3.3, §7)

// ---- アプリ識別子(G0 で人間が最終決定 — DESIGN §3.1)
// 変更が必要になったら、この2行と各ターゲットの *.entitlements を更新する。
// project.yml 側は $(LIEN_BUNDLE_ID_BASE) 参照なので触らなくてよい。
LIEN_BUNDLE_ID_BASE = com.ryoki63.lien
LIEN_APP_GROUP_ID = group.com.ryoki63.lien.shared

// ---- 言語・デバイス
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1

// ---- バージョン(Info.plist の $(MARKETING_VERSION) / $(CURRENT_PROJECT_VERSION) が参照)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ---- Supabase 接続情報の既定値(空)
// CI には Secrets.xcconfig が無いが、空のままでもビルドは通る(DESIGN §7)。
// 実値は Secrets.xcconfig(gitignore 済み)が下の optional include で上書きする。
SUPABASE_URL =
SUPABASE_ANON_KEY =

// ---- optional include: ファイルが存在しなくてもエラーにならない(末尾の ? が重要)
// Secrets.example.xcconfig を Secrets.xcconfig にコピーして実値を入れる(人間 / G0)
#include? "Secrets.xcconfig"
